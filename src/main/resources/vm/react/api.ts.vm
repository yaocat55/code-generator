import { request } from '@umijs/max';

export interface ${className}Record {
  id: number;
#foreach ($column in $columns)
  $column.attrname#if($column.attrType == "String" || $column.attrType == "Integer" || $column.attrType == "Long" || $column.attrType == "Float" || $column.attrType == "Double" || $column.attrType == "BigDecimal" || $column.attrType == "Boolean"): $column.attrType | null#end;
#end
}

export async function getPage(params: any) {
  return request<{ content: ${className}Record[]; totalElements: number }>(
    '/v1/${classname}/searchByPage',
    { method: 'POST', data: params },
  );
}

export async function add(data: Partial<${className}Record>) {
  return request('/v1/${classname}/insert', { method: 'POST', data });
}

export async function edit(data: Partial<${className}Record>) {
  return request('/v1/${classname}/update', { method: 'POST', data });
}

export async function del(ids: number[]) {
  return request('/v1/${classname}/deleteByIds', { method: 'POST', data: ids });
}
