<template>
  <div class="app-container">
    <!-- 搜索 -->
    <el-form :model="query" :inline="true" size="small">
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'isDel')
      <el-form-item label="$column.columnComment">
        <el-input v-model="query.$column.attrname" placeholder="请输入$column.columnComment" clearable />
      </el-form-item>
#end
#end
      <el-form-item>
        <el-button type="primary" icon="el-icon-search" @click="handleQuery">搜索</el-button>
        <el-button icon="el-icon-refresh" @click="handleReset">重置</el-button>
      </el-form-item>
    </el-form>

    <!-- 操作栏 -->
    <el-row :gutter="10" style="margin-bottom: 16px">
      <el-button type="primary" icon="el-icon-plus" size="small" @click="handleAdd">新增</el-button>
      <el-button type="danger" icon="el-icon-delete" size="small" :disabled="selection.length === 0" @click="handleBatchDelete">批量删除</el-button>
    </el-row>

    <!-- 表格 -->
    <el-table :data="list" v-loading="loading" border stripe @selection-change="handleSelectionChange">
      <el-table-column type="selection" width="55" align="center" />
      <el-table-column label="ID" prop="id" width="80" align="center" />
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'isDel')
      <el-table-column label="$column.columnComment" prop="$column.attrname" show-overflow-tooltip />
#end
#end
      <el-table-column label="创建人ID" prop="createUserId" width="100" align="center" />
      <el-table-column label="创建人" prop="createUserName" width="120" show-overflow-tooltip />
      <el-table-column label="创建时间" prop="createTime" width="160" align="center" />
      <el-table-column label="操作" width="150" align="center" fixed="right">
        <template slot-scope="{row}">
          <el-button type="primary" size="mini" icon="el-icon-edit" @click="handleEdit(row)">编辑</el-button>
          <el-button type="danger" size="mini" icon="el-icon-delete" @click="handleDelete(row)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>

    <!-- 分页 -->
    <el-pagination
      style="margin-top: 16px; text-align: right"
      :current-page="query.page"
      :page-sizes="[10, 20, 50, 100]"
      :page-size="query.limit"
      :total="total"
      layout="total, sizes, prev, pager, next, jumper"
      @size-change="handleSizeChange"
      @current-change="handleCurrentChange"
    />

    <!-- 弹窗 -->
    <el-dialog :title="dialogTitle" :visible.sync="dialogVisible" width="500px" @close="handleDialogClose">
      <el-form ref="formRef" :model="form" :rules="rules" label-width="100px" size="small">
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'createUserId' && $column.attrname != 'createUserName' && $column.attrname != 'createTime' && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName' && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        <el-form-item label="$column.columnComment" prop="$column.attrname">
          <el-input v-model="form.$column.attrname" placeholder="请输入$column.columnComment" />
        </el-form-item>
#end
#end
      </el-form>
      <div slot="footer">
        <el-button @click="dialogVisible = false">取 消</el-button>
        <el-button type="primary" @click="submitForm">确 定</el-button>
      </div>
    </el-dialog>
  </div>
</template>

<script>
import { getPage, add, edit, del } from './api'

const defaultForm = {
  id: null,
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'createUserId' && $column.attrname != 'createUserName' && $column.attrname != 'createTime' && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName' && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
  $column.attrname: null,
#end
#end
}

export default {
  name: '${className}',
  data() {
    return {
      list: [],
      total: 0,
      loading: false,
      selection: [],
      dialogVisible: false,
      query: {
        page: 1,
        limit: 10,
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'isDel')
        $column.attrname: '',
#end
#end
      },
      form: { ...defaultForm },
      rules: {
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'createUserId' && $column.attrname != 'createUserName' && $column.attrname != 'createTime' && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName' && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        $column.attrname: [{ required: true, message: '请输入$column.columnComment', trigger: 'blur' }],
#end
#end
      }
    }
  },
  computed: {
    dialogTitle() {
      return this.form.id ? '编辑${tableComment}' : '新增${tableComment}'
    }
  },
  created() {
    this.getList()
  },
  methods: {
    async getList() {
      this.loading = true
      try {
        const res = await getPage(this.query)
        this.list = res.content || []
        this.total = res.totalElements || 0
      } finally {
        this.loading = false
      }
    },
    handleQuery() {
      this.query.page = 1
      this.getList()
    },
    handleReset() {
      this.query = {
        page: 1,
        limit: this.query.limit,
#foreach ($column in $columns)
#if($column.attrname != 'id' && $column.attrname != 'isDel')
        $column.attrname: '',
#end
#end
      }
      this.getList()
    },
    handleSizeChange(limit) {
      this.query.limit = limit
      this.getList()
    },
    handleCurrentChange(page) {
      this.query.page = page
      this.getList()
    },
    handleSelectionChange(val) {
      this.selection = val
    },
    handleAdd() {
      this.form = { ...defaultForm }
      this.dialogVisible = true
    },
    handleEdit(row) {
      this.form = { ...row }
      this.dialogVisible = true
    },
    handleDelete(row) {
      this.$confirm('确认删除该记录？', '提示', { type: 'warning' })
        .then(async () => {
          await del([row.id])
          this.$message.success('删除成功')
          this.getList()
        })
        .catch(() => {})
    },
    handleBatchDelete() {
      if (this.selection.length === 0) return
      this.$confirm(`确认删除选中的 ${this.selection.length} 条记录？`, '提示', { type: 'warning' })
        .then(async () => {
          await del(this.selection.map(item => item.id))
          this.$message.success('删除成功')
          this.getList()
        })
        .catch(() => {})
    },
    submitForm() {
      this.$refs.formRef.validate(async valid => {
        if (!valid) return
        try {
          if (this.form.id) {
            await edit(this.form)
            this.$message.success('更新成功')
          } else {
            await add(this.form)
            this.$message.success('新增成功')
          }
          this.dialogVisible = false
          this.getList()
        } catch {
          this.$message.error('操作失败')
        }
      })
    },
    handleDialogClose() {
      this.$refs.formRef?.resetFields()
    }
  }
}
</script>

<style scoped>
.app-container {
  padding: 20px;
}
</style>
