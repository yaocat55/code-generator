package ${basePackage}.web.controller;

import ${package}.entity.${className}Entity;
import ${package}.service.${className}Service;
import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import jakarta.validation.constraints.NotNull;
import java.util.List;

/**
 * ${tableComment} 接口层 (MyBatis-Plus)
 *
 * @author ${author}
 * @date ${datetime}
 */
@Tag(name = "${tableComment}操作", description = "${tableComment}接口")
@RestController
@RequestMapping("/v1/${classname}")
public class ${className}Controller {

    @Autowired
    private ${className}Service ${classname}Service;

    @Operation(summary = "根据ID查询${tableComment}")
    @GetMapping("/{id}")
    public ${className}Entity findById(@PathVariable Long id) {
        return ${classname}Service.getById(id);
    }

    @Operation(summary = "分页查询${tableComment}")
    @GetMapping("/page")
    public Page<${className}Entity> findByPage(
            @RequestParam(defaultValue = "1") int pageNum,
            @RequestParam(defaultValue = "10") int pageSize) {
        Page<${className}Entity> page = new Page<>(pageNum, pageSize);
        LambdaQueryWrapper<${className}Entity> wrapper = new LambdaQueryWrapper<>();
        wrapper.orderByDesc(${className}Entity::getCreateTime);
        return ${classname}Service.page(page, wrapper);
    }

    @Operation(summary = "查询${tableComment}列表")
    @GetMapping("/list")
    public List<${className}Entity> findList() {
        LambdaQueryWrapper<${className}Entity> wrapper = new LambdaQueryWrapper<>();
        wrapper.orderByDesc(${className}Entity::getCreateTime);
        return ${classname}Service.list(wrapper);
    }

    @Operation(summary = "新增${tableComment}")
    @PostMapping
    public boolean insert(@RequestBody ${className}Entity ${classname}Entity) {
        return ${classname}Service.save(${classname}Entity);
    }

    @Operation(summary = "修改${tableComment}")
    @PutMapping
    public boolean update(@RequestBody ${className}Entity ${classname}Entity) {
        return ${classname}Service.updateById(${classname}Entity);
    }

    @Operation(summary = "删除${tableComment}")
    @DeleteMapping("/{id}")
    public boolean delete(@PathVariable Long id) {
        return ${classname}Service.removeById(id);
    }

    @Operation(summary = "批量删除${tableComment}")
    @DeleteMapping("/batch")
    public boolean deleteBatch(@RequestBody List<Long> ids) {
        return ${classname}Service.removeBatchByIds(ids);
    }
}
