package ${package}.mapper;

import ${package}.entity.${className}Entity;
import ${package}.entity.${className}ConditionEntity;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

/**
 * ${tableComment} Mapper 单元测试
 *
 * @author ${author}
 * @date ${datetime}
 */
@SpringBootTest
@Transactional
class ${className}MapperTest {

    @Autowired
    private ${className}Mapper ${classname}Mapper;

    @Test
    void testFindById() {
        Long testId = 1L;
        ${className}Entity result = ${classname}Mapper.findById(testId);
        assertNotNull("查询结果不应为空", result);
        assertEquals("ID应该匹配", testId, result.getId());
    }

    @Test
    void testInsert() {
        ${className}Entity entity = new ${className}Entity();
        entity.setId(1L);
        #foreach($column in $columns)
        #if($column.attrname != 'id' && $column.attrname != 'createUserId'
            && $column.attrname != 'createUserName' && $column.attrname != 'createTime'
            && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName'
            && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        #if($column.attrType == 'String')
        entity.set${column.attrName}("测试${column.columnComment}");
        #elseif($column.attrType == 'Integer')
        entity.set${column.attrName}(1);
        #elseif($column.attrType == 'Long')
        entity.set${column.attrName}(1L);
        #elseif($column.attrType == 'Date')
        entity.set${column.attrName}(new java.util.Date());
        #elseif($column.attrType == 'BigDecimal')
        entity.set${column.attrName}(new java.math.BigDecimal("0.00"));
        #else
        entity.set${column.attrName}(null);
        #end
        #end
        #end
        int result = ${classname}Mapper.insert(entity);
        assertEquals("插入应该成功", 1, result);
    }

    @Test
    void testUpdate() {
        Long testId = 1L;
        ${className}Entity entity = ${classname}Mapper.findById(testId);
        assertNotNull("测试数据应该存在", entity);
        #foreach($column in $columns)
        #if($column.attrname != 'id' && $column.attrname != 'createUserId'
            && $column.attrname != 'createUserName' && $column.attrname != 'createTime'
            && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName'
            && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        #if($column.attrType == 'String')
        entity.set${column.attrName}("更新后的${column.columnComment}");
        #end
        #end
        #end
        int result = ${classname}Mapper.update(entity);
        assertEquals("更新应该成功", 1, result);
    }

    @Test
    void testFindByIds() {
        List<Long> ids = new ArrayList<>();
        ids.add(1L);
        ids.add(2L);
        List<${className}Entity> result = ${classname}Mapper.findByIds(ids);
        assertNotNull("查询结果不应为空", result);
        assertTrue("应该查询到数据", result.size() > 0);
    }

    @Test
    void testSearchByCondition() {
        ${className}ConditionEntity condition = new ${className}ConditionEntity();
        condition.setPageNo(1);
        condition.setPageSize(10);
        List<${className}Entity> result = ${classname}Mapper.searchByCondition(condition);
        assertNotNull("查询结果不应为空", result);
    }

    @Test
    void testDeleteByIds() {
        List<Long> ids = new ArrayList<>();
        ids.add(1L);
        ${className}Entity entity = new ${className}Entity();
        int result = ${classname}Mapper.deleteByIds(ids, entity);
        assertTrue("删除操作应该执行", result >= 0);
    }
}
