     * @param ${classname}Entity ${tableComment}实体
     * @return 影响行数
     */
	@Operation(summary = "修改${tableComment}")
	@PutMapping
	public int update(@RequestBody ${className}Entity ${classname}Entity) {
		return ${classname}Service.update(${classname}Entity);
	}

	/**
     * 批量删除${tableComment}
