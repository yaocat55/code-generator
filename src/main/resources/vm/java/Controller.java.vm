     * @return 影响行数
     */
	@Operation(summary = "添加${tableComment}")
	@PostMapping
	public int insert(@RequestBody ${className}Entity ${classname}Entity) {
		return ${classname}Service.insert(${classname}Entity);
	}

	/**
     * 修改${tableComment}
