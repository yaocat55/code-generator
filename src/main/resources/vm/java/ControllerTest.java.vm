package ${basePackage}.web.controller;

import ${package}.entity.${className}Entity;
import ${package}.entity.${className}ConditionEntity;
import ${package}.entity.ResponsePageEntity;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.junit4.SpringRunner;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.List;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
import static org.junit.Assert.*;

/**
 * ${tableComment} Controller 单元测试
 *
 * @author ${author}
 * @date ${datetime}
 */
@RunWith(SpringRunner.class)
@SpringBootTest(classes = cn.net.yao.generate.Application.class)
@AutoConfigureMockMvc
@Transactional
public class ${className}ControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @Test
    public void testFindById() throws Exception {
        Long testId = 1L;
        mockMvc.perform(get("/v1/${classname}/findById")
                .param("id", testId.toString()))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(testId));
    }

    @Test
    public void testSearchByPage() throws Exception {
        ${className}ConditionEntity condition = new ${className}ConditionEntity();
        condition.setPageNo(1);
        condition.setPageSize(10);
        mockMvc.perform(post("/v1/${classname}/searchByPage")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(condition)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data").exists());
    }

    @Test
    public void testInsert() throws Exception {
        ${className}Entity entity = new ${className}Entity();
        entity.setId(1L);
        #foreach($column in $columns)
        #if($column.attrname != 'id' && $column.attrname != 'createUserId'
            && $column.attrname != 'createUserName' && $column.attrname != 'createTime'
            && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName'
            && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        #if($column.attrType == 'String')
        entity.set${column.attrName}("测试${column.columnComment}");
        #elseif($column.attrType == 'Integer')
        entity.set${column.attrName}(1);
        #elseif($column.attrType == 'Long')
        entity.set${column.attrName}(1L);
        #elseif($column.attrType == 'Date')
        entity.set${column.attrName}(new java.util.Date());
        #elseif($column.attrType == 'BigDecimal')
        entity.set${column.attrName}(new java.math.BigDecimal("0.00"));
        #else
        entity.set${column.attrName}(null);
        #end
        #end
        #end
        mockMvc.perform(post("/v1/${classname}/insert")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(entity)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$").isNumber());
    }

    @Test
    public void testUpdate() throws Exception {
        Long testId = 1L;
        ${className}Entity entity = new ${className}Entity();
        entity.setId(testId);
        #foreach($column in $columns)
        #if($column.attrname != 'id' && $column.attrname != 'createUserId'
            && $column.attrname != 'createUserName' && $column.attrname != 'createTime'
            && $column.attrname != 'updateUserId' && $column.attrname != 'updateUserName'
            && $column.attrname != 'updateTime' && $column.attrname != 'isDel')
        #if($column.attrType == 'String')
        entity.set${column.attrName}("更新后的${column.columnComment}");
        #end
        #end
        #end
        mockMvc.perform(post("/v1/${classname}/update")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(entity)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$").isNumber());
    }

    @Test
    public void testDeleteByIds() throws Exception {
        List<Long> ids = new ArrayList<>();
        ids.add(1L);
        mockMvc.perform(post("/v1/${classname}/deleteByIds")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(ids)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$").isNumber());
    }
}
